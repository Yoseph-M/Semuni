# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database (must match docker-compose.yml Postgres) ─────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=semuni
DB_PASSWORD=semuni_dev_password
DB_DATABASE=semuni

# ─── JWT ───────────────────────────────────────────────────
# Access and refresh tokens MUST use different secrets. Issued refresh tokens
# are tracked server-side in `refresh_sessions` (SHA-256 hash only), rotated on
# use and revoked on logout.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated origins. `*` is dev-only (no credentials) and refused in production.
CORS_ORIGIN=*

# Swagger UI at /api/docs: on by default outside production, off in production.
# SWAGGER_ENABLED=false

# ─── Rate Limiting ─────────────────────────────────────────
# Global default applied to every route.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Stricter limits for the auth endpoints (requests allowed per AUTH_THROTTLE_TTL ms).
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_REGISTER_LIMIT=5
AUTH_THROTTLE_LOGIN_LIMIT=10
AUTH_THROTTLE_REFRESH_LIMIT=20

# Per-account lockout after consecutive failed passwords.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Set to the proxy hop count / IPs when behind a load balancer so rate limits
# key on the real client IP (false, true, a number, or comma-separated IPs).
TRUST_PROXY=false

# ─── Logging ──────────────────────────────────────────────
# json (default in production) or pretty
# LOG_FORMAT=json

# ─── Payment Providers ────────────────────────────────────
# MOCK for development (refused in production); TELEBIRR for real payments.
PAYMENT_PROVIDER=MOCK

# Telebirr H5 C2B web checkout (developer.ethiotelecom.et). Required when
# PAYMENT_PROVIDER=TELEBIRR. Never commit real values.
# Testbed: https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# Production: https://superapp.ethiomobilemoney.et:38443/apiaccess/payment/gateway
TELEBIRR_BASE_URL=
# Testbed: https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
TELEBIRR_WEB_CHECKOUT_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
# Your RSA private key (PEM or bare base64; "\n" escapes allowed).
TELEBIRR_PRIVATE_KEY=
# Telebirr's public key, used to verify payment notifications.
TELEBIRR_PUBLIC_KEY=
# Public https URL of POST /api/v1/wallet/webhooks/telebirr (whitelisted by Telebirr).
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=
TELEBIRR_HTTP_TIMEOUT_MS=10000
TELEBIRR_ORDER_TIMEOUT_MINUTES=120
TELEBIRR_NOTIFY_MAX_AGE_SECONDS=3600

# Top-up reconciliation (npm run reconcile:top-ups)
RECONCILE_OLDER_THAN_MINUTES=10
RECONCILE_EXPIRE_AFTER_MINUTES=1440
