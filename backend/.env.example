# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database (must match docker-compose.yml Postgres) ─────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=semuni
DB_PASSWORD=semuni_dev_password
DB_DATABASE=semuni

# ─── JWT ───────────────────────────────────────────────────
# Access and refresh tokens MUST use different secrets. Issued refresh tokens
# are tracked server-side in `refresh_sessions` (SHA-256 hash only), rotated on
# use and revoked on logout.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Rate Limiting ─────────────────────────────────────────
# Global default applied to every route.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Stricter limits for the auth endpoints (requests allowed per AUTH_THROTTLE_TTL ms).
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_REGISTER_LIMIT=5
AUTH_THROTTLE_LOGIN_LIMIT=10
AUTH_THROTTLE_REFRESH_LIMIT=20

# ─── Payment Providers (mock for development) ─────────────
PAYMENT_PROVIDER=MOCK
