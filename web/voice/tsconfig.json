{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["jest", "node"],
    "typeRoots": ["../../backend/node_modules/@types"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
